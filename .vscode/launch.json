{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "All Tests",
			"type": "node",
			"request": "launch",
			"skipFiles": [
				"<node_internals>/**"
			],
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/build/run-tests.js",
			"outputCapture": "std",
			"internalConsoleOptions": "openOnSessionStart",
		},
		{
			"name": "100) Process Runtime Tests",
			"type": "node",
			"request": "launch",
			"skipFiles": [
				"<node_internals>/**"
			],
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/node_modules/mocha/bin/mocha",
			"args": [
				"-u",
				"bdd",
				"test/Unit Tests/100*.js",
				"--timeout",
				"0",
				"--slow",
				"10",
				"--colors",
			],
			"outputCapture": "std",
			"internalConsoleOptions": "openOnSessionStart",
		},
		{
			"name": "Process Invariants",
			"type": "node",
			"request": "launch",
			"skipFiles": [
				"<node_internals>/**"
			],
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/build/process-check.js",
			"args": [
				"--verbose",
			],
			"outputCapture": "std",
			"internalConsoleOptions": "openOnSessionStart",
		},
		{
			"name": "Check Docs",
			"type": "node",
			"request": "launch",
			"skipFiles": [
				"<node_internals>/**"
			],
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/build/docs-check.js",
			"args": [
				"--verbose",
			],
			"outputCapture": "std",
			"internalConsoleOptions": "openOnSessionStart",
		},
	]
}
